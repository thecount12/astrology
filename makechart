#!/bin/rc
# Usage: ./makechart YEAR MONTH DAY `{./hms HH:MM} TZ LAT LON
# Example: ./makechart 1974 05 18 `{./hms 4:16 am} -8.0 36.33 -119.95

year=$1
month=$2
day=$3
local_hour=$4
tz_offset=$5
lat=$6
lon=$7

# Compute Greenwich Time via standard shell arithmetic
ut_hour=`{ hoc -e $local_hour'-('$tz_offset')' }

# Run calculations and split the outputs into standalone clean variables
asc_data=`{ ./ascendant $year $month $day $local_hour $tz_offset $lat $lon }
asc_sign=$asc_data(1)
asc_deg=$asc_data(2)

# Pull deep space geocentric coordinates from your ephemeris binary
pos=`{ ./ephem $year $month $day $ut_hour }

# Fire elements down the line matching the precise manual index positions
#./chart $year $asc_sign $asc_deg $local_hour $month'/'$day $lat $lon $pos | pic | troff | lp -dstdout | ps2pdf > blah.pdf
./chart $year $asc_sign $asc_deg $local_hour $month'/'$day $lat $lon $pos | pic | troff | page -w


