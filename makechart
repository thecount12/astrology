#!/bin/rc
# Usage: ./makechart [Year] [Month] [Day] [Hour_UT] [RisingSign] [AscDeg] [Lat] [Long]
# ./makechart 1974 05 18 12.0 taurus 15.0 36.20N 119.57W

# 1. Format the data parameters into the exact structures each binary expects
year=$1
month=$2
day=$3
ut_time=$4
rising_sign=$5
asc_deg=$6
latitude=$7
longitude=$8

# Create a clean combined "Month/Day" string for the chart4 text title banner
dob_string=$month/$day

# 2. Run the dynamic astronomical math engine to extract raw positions
# Example expansion: ./ephem 1974 5 18 12.0
pos=`{ ./ephem $year $month $day $ut_time }

# 3. Pass the year, strings, degrees, AND the calculated positions directly into chart4
# The shell automatically expands the space-separated $pos array into items 8 through 14
./chart4 $year $rising_sign $asc_deg $ut_time $dob_string $latitude $longitude $pos | pic | troff | page -w
